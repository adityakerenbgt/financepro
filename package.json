{
  "name": "financepro",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "format": "prettier --write \"{app,lib}/**/*.{ts,tsx}\"",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-demo": "tsx prisma/seed-demo.ts",
    "test:api": "tsx --env-file=.env --env-file=.env.local --test --test-concurrency=1 tests/api/*.test.ts",
    "test:unit": "tsx --test lib/*.test.ts",
    "storage:setup": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/setup-storage.ts",
    "telegram:webhook": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/set-telegram-webhook.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate && node scripts/copy-tesseract.js"
  },
  "dependencies": {
    "@prisma/client": "^5.12.0",
    "@sentry/nextjs": "8.55.0",
    "@supabase/storage-js": "^2.119.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/ind": "1.0.0",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "exceljs": "^4.4.0",
    "grammy": "^1.21.0",
    "jose": "^6.2.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.469.0",
    "next": "^15.5.29",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^2.12.0",
    "tailwind-merge": "^2.2.0",
    "tesseract.js": "5.1.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.4.0",
    "prettier": "^3.3.3",
    "prisma": "^5.12.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
