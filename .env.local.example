# Database (PostgreSQL - Supabase / Neon / Postgres lokal)
DATABASE_URL="postgresql://user:password@host:5432/financepro?sslmode=require"

# WAJIB: minimal 32 karakter acak. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# App URL (update after deploying to Vercel)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Hanya untuk `npm run db:seed` (taruh di .env)
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# Rate limiting (opsional di dev; Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email transaksional (Resend). Kosongkan di dev: email dilewati dan dicatat di log.
# EMAIL_FROM harus memakai domain yang sudah diverifikasi di Resend (SPF + DKIM).
RESEND_API_KEY=
EMAIL_FROM="FinancePro <no-reply@grexion.ai>"

# Kontak WhatsApp admin untuk info pembayaran (format internasional tanpa +, mis. 6281234567890).
# Info rekening diberikan admin lewat chat, jadi tidak ada data rekening di aplikasi.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Bukti pembayaran (Supabase Storage, bucket PRIVAT "payment-proofs").
# SERVICE ROLE KEY = rahasia server: jangan pakai awalan NEXT_PUBLIC_ dan jangan di-commit.
# Supabase > Project Settings > API. Setelah diisi jalankan sekali:  npm run storage:setup
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Melindungi endpoint cron /api/cron/expire-plans (Vercel mengirimnya sebagai Authorization: Bearer <nilai>).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Batas koneksi Prisma per instance (default 5; pooler Supabase mode session maks ~15)
# DB_POOL_SIZE=5

# Bot Telegram: CUKUP token dari @BotFather. Rahasia webhook, username, menu perintah, dan deskripsi dibuat otomatis
# (aktifkan dengan satu tombol di Panel Admin setelah deploy; lokal: npm run telegram:poll).
# TELEGRAM_WEBHOOK_SECRET dan TELEGRAM_BOT_USERNAME opsional (menimpa nilai otomatis).
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
ADMIN_NOTIFY_EMAIL=

# Sentry (opsional; kosong = nonaktif). DSN publik; token hanya untuk upload source map saat build di Vercel
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Scan Nota. RECEIPT_PROVIDER: ondevice (bawaan; OCR di browser, gratis, foto tidak keluar dari perangkat)
#   | groq | openrouter | mistral | openai (alamat sendiri via RECEIPT_API_BASE) | gemini
# Penyedia AI gratis (lebih akurat dari OCR): Groq -> console.groq.com (Create API Key), lalu:
#   RECEIPT_PROVIDER=groq  dan  RECEIPT_API_KEY=<kunci Groq>   (RECEIPT_MODEL opsional; bawaan qwen/qwen3.8-27b.
#   Daftar model berubah: curl -H "Authorization: Bearer $KUNCI" https://api.groq.com/openai/v1/models)
# Bila penyedia AI gagal/kena batas, halaman otomatis memakai OCR di perangkat.
RECEIPT_PROVIDER=ondevice
RECEIPT_API_KEY=
RECEIPT_MODEL=
RECEIPT_API_BASE=
# Khusus Gemini:
GEMINI_API_KEY=
# Opsional; bawaan gemini-2.5-flash
GEMINI_MODEL=
