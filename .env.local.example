# Database (PostgreSQL - Supabase / Neon / Postgres lokal)
DATABASE_URL="postgresql://user:password@host:5432/financepro?sslmode=require"

# WAJIB: minimal 32 karakter acak. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# App URL (update after deploying to Vercel)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Hanya untuk `npm run db:seed` (taruh di .env)
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# Rate limiting (opsional di dev; Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email transaksional (Resend). Kosongkan di dev: email dilewati dan dicatat di log.
# EMAIL_FROM harus memakai domain yang sudah diverifikasi di Resend (SPF + DKIM).
RESEND_API_KEY=
EMAIL_FROM="FinancePro <no-reply@grexion.ai>"

# Kontak WhatsApp admin untuk info pembayaran (format internasional tanpa +, mis. 6281234567890).
# Info rekening diberikan admin lewat chat, jadi tidak ada data rekening di aplikasi.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Bukti pembayaran (Supabase Storage, bucket PRIVAT "payment-proofs").
# SERVICE ROLE KEY = rahasia server: jangan pakai awalan NEXT_PUBLIC_ dan jangan di-commit.
# Supabase > Project Settings > API. Setelah diisi jalankan sekali:  npm run storage:setup
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Melindungi endpoint cron /api/cron/expire-plans (Vercel mengirimnya sebagai Authorization: Bearer <nilai>).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Batas koneksi Prisma per instance (default 5; pooler Supabase mode session maks ~15)
# DB_POOL_SIZE=5
