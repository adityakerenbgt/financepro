# =============================================================
# FinancePro — contoh environment variable
# Salin ke `.env.local` DAN `.env` (Prisma CLI hanya membaca `.env`).
# JANGAN commit file .env / .env.local. Jangan tempel nilai asli ke AI/chat.
# =============================================================

# ---------- WAJIB SEKARANG ----------

# Koneksi PostgreSQL milikmu sendiri (Supabase Direct connection atau Postgres lokal)
# Docker lokal:  postgresql://postgres:postgres@localhost:5432/financepro
# Supabase:      postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/financepro"

# Tanda tangan JWT. Minimal 32 karakter acak. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Harus SAMA di .env dan .env.local. Berbeda untuk tiap lingkungan (lokal ≠ produksi).
JWT_SECRET="GANTI_DENGAN_HASIL_PERINTAH_DI_ATAS"

# URL aplikasi (dev: http://localhost:3000 ; produksi: https://financepro.grexion.ai)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ---------- OPSIONAL ----------

# Bot Telegram (pakai bot UJI milik sendiri dari @BotFather; belum aman untuk produksi — lihat T-BOT-1)
TELEGRAM_BOT_TOKEN=""

# ---------- AKAN DIPAKAI OLEH TASK TERTENTU (kode saat ini belum membacanya) ----------

# P0-3  Seed admin lokal (menggantikan password yang tertanam di seed.ts)
SEED_ADMIN_USERNAME=""
SEED_ADMIN_PASSWORD=""

# P0-5  Rate limiting (Upstash Redis, ada free tier)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# T-2.3  Email (Resend). Tanpa key, email dilewati dan dicatat di log (sudah dibaca kode).
#        EMAIL_FROM harus memakai domain yang diverifikasi di Resend (SPF + DKIM).
RESEND_API_KEY=""
EMAIL_FROM="FinancePro <no-reply@grexion.ai>"

# T-3.4  Kontak WhatsApp admin untuk info pembayaran (format internasional tanpa +). Tanpa ini tombol jatuh ke email.
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# T-3.2  Bukti pembayaran (Supabase Storage, bucket privat). SERVICE ROLE = rahasia server, JANGAN pakai NEXT_PUBLIC_
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# T-4.1  Melindungi endpoint cron (Vercel mengirimnya sebagai Authorization: Bearer <nilai>)
CRON_SECRET=""

# T-6.2  Error tracking
SENTRY_DSN=""
